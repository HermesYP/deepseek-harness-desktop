# Reference checkout: a read-only upstream clone pinned for comparison.
# It is never part of this repository.
_upstream/

# Build outputs and generated trees
port/src-tauri/target/
/.tmp-cargo/
# Accidental nested build/probe output; retained, never a source root.
/port/src-tauri/port/
port/ui/dist/
# Transactional UI publication backups and nested compile caches are generated.
port/ui/dist.previous/
port/ui/dist.previous-*/
port/ui/native-guests/.tmp/
port/ui/native-guests/.cache/
port/ui/client-updates/lib/
port/ui/node_modules/
# Generated junction to the selected upstream checkout (see port/ui/link-toolchain.ps1).
# It is a link, never content, and it points at a read-only reference tree.
port/.upstream
port/runtime-payload/
# Generated runtime seal inventory, not the checked-in Node pin specification.
/port/installer/runtime-payload.json
port/.scratch/
/.scratch/
/outputs/
port/ui/.cache/
port/ui/.scratch-guests/

# Retained one-off probes, never source inputs (ignore, do not delete)
/${REPORT}
/${REPORT}.*
/probe-*.mjs

# Installers and compiled binaries
*.exe
*.msi
*.dll
*.pdb
*.node

# Logs and transient captures
*.log

# Stray scratch harness home created during development: contains a credential
# store and real session data. Never commit it.
.ref-home/

# Harness homes, credentials and evidence captured against a real session must
# never be committed. The gate in scripts/check-repo-hygiene.mjs enforces this.
**/.credentials.yaml
**/.anonymous-user-id
/docs/evidence/port-sessions/

# Nested package metadata anywhere in the tree
**/node_modules/
